{
    "name": "@flybyme/mesh-demos",
    "version": "0.1.0",
    "description": "Several parts in one repository: what the framework looks like when it is used rather than proved.",
    "type": "module",
    "private": true,
    "scripts": {
        "generate": "mesh-serve client",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test:browser": "vitest run --config vitest.browser.config.ts",
        "test": "npm run typecheck && npm run test:browser",
        "dev": "mesh-serve dev"
    },
    "devDependencies": {
        "@flybyme/mesh-serve": "file:../mesh-serve",
        "@flybyme/mesh-web": "github:FLYBYME/mesh-web#v0.14.0",
        "@vitest/browser": "^2.1.9",
        "playwright": "^1.62.1",
        "typescript": "^5.9.3",
        "vitest": "^2.1.9"
    }
}
